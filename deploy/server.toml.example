# Haven server configuration — /etc/haven/server.toml
#
# The storage directory holds every pack and manifest. Put it on a local
# filesystem with plenty of space: SQLite (state/index.sqlite) and POSIX file
# locks are used, so NFS/CIFS are not supported for the repository itself.
# Encrypt the volume (LUKS) — the repository stores data unencrypted, see
# docs/security.md.

[server]
# Listen on all interfaces for a dedicated backup VLAN, or keep 127.0.0.1 and
# put nginx/stunnel in front. Port 8443 needs no privileges.
bind = "0.0.0.0:8443"
storage = "/var/lib/haven/repo"

# TLS is strongly recommended; havend refuses nothing without it, but a plain
# HTTP endpoint carries the bearer token in clear text.
tls_cert = "/etc/haven/tls/server.crt"
tls_key = "/etc/haven/tls/server.key"

# Repository secret: signs manifests so the server and clients can detect
# tampered metadata. Generated by `havend init`, must be identical on clients.
secret_file = "/etc/haven/repo.secret"

# Client credentials (SHA-256 hashes only, mode 0600).
tokens_file = "/etc/haven/tokens.json"

# Largest accepted upload; a pack is one backup run's new data, so this must be
# bigger than the biggest nightly delta. Clients also cap their pack at this.
max_pack_bytes = "2G"

# INFO is the right level for production; DEBUG logs every request.
log_level = "INFO"
